<!DOCTYPE html>
<html>
<head>
    <title>Home</title>
    <link rel='stylesheet' href='/stylesheets/style.css'/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
</head>
<body class="login-page">
<div class="page-container">
    <h1>Home</h1>
    <p>dashboard (<a href="/auth/logout">logout</a>)</p>
    <div class="page-body">
        <div class="items-list">
        </div>
    </div>
</div>
<script>
    function removeDevice(did) {
        fetch('/api/devices/' + did, {
            method: 'DELETE',
        }).then(() => {
            return getDevices();
        });
    }

    function getDevices() {
        return fetch('/api/devices/', {
            method: 'GET',
        }).then((res) => {
            return res.json();
        }).then(devices => {
            const itemsList = document.querySelector('.items-list');
            itemsList.innerHTML = '';
            devices.forEach(device => createHtmlDeviceElement(device, itemsList));
        });
    }

    function createHtmlDeviceElement(device, itemsList) {
        const item = document.createElement('div');
        item.className = "item-device";

        const info = document.createElement('div');
        info.className = "info";
        info.innerHTML = `
      <span>ID: ${device.did}</span>
      <span>Name: ${device.name.name}</span>
      <span class="${device.online ? "online" : "offline"}">${device.online ? 'ONLINE' : 'OFFLINE'}</span>
    `;
        item.appendChild(info);

        const space = document.createElement('div');
        space.style.height = "100%";
        item.appendChild(space);

        item.appendChild(createIcon(device));

        const buttonsContainer = document.createElement('div');
        buttonsContainer.className = "buttons-container";
        item.appendChild(buttonsContainer);

        const button = document.createElement('button');
        button.onclick = () => openRemoveDialog(device.did);
        button.innerHTML = `remove`;
        button.className = "removeButton";
        buttonsContainer.appendChild(button);

        if (device.type === 'action.devices.types.CAMERA') {
            const buttonStream = document.createElement('button');
            buttonStream.onclick = () => {
                window.open(`/stream/${device.did}`, '_blank');
            };
            buttonStream.innerHTML = `stream`;
            buttonStream.className = "streamButton";
            buttonsContainer.appendChild(buttonStream);
        }

        itemsList.appendChild(item);
    }

    function createIcon(device) {
        const icon = document.createElement('div');
        icon.className = `icon ${device.params.on || device.params.isRunning ? '' : 'off'}`;
        // html icon for a light
        if (device.type === 'action.devices.types.OUTLET') {
            icon.innerHTML = '<div class="circle"> <div class="rays"> <div class="r r1"></div> <div class="r r2"></div> <div class="r r3"></div> <div class="r r4"></div> <div class="r r5"></div> </div> </div> <div class="d"></div> <div class="d d1"></div> <div class="d d2"></div> <div class="d d3"></div>';
            icon.className = `icon-light ${device.params.on || device.params.isRunning ? '' : 'off'}`;
        } else if (device.type === 'action.devices.types.PETFEEDER') {
            icon.innerHTML = '<div class="icon-feader"><div class="base"></div><div class="finger finger1"></div><div class="finger finger2"></div> <div class="finger finger3"></div> <div class="finger finger4"></div></div>'
            icon.className = 'icon-feader';
        } else if (device.type === 'action.devices.types.CAMERA') {
            icon.innerHTML = '<div class="body"></div><div class="lent"></div>'
            icon.className = 'icon-camera';
        }
        return icon;
    }

    function openRemoveDialog(did) {
        const dialog = document.createElement('div');
        dialog.className = "dialog-container";
        dialog.innerHTML = `
      <div class="dialog">
        <div class="dialog-content">
          <h2>Are you sure you want to remove this device?</h2>
          <button onclick="removeDevice('${did}');this.parentElement.parentElement.parentElement.remove();">Yes</button>
          <button onclick="this.parentElement.parentElement.parentElement.remove()">No</button>
        </div>
      </div>
    `;
        document.body.appendChild(dialog);
    }

    (function () {
        getDevices();

        setInterval(() => {
            getDevices();
        }, 5000);
    })();

</script>
</body>
</html>
