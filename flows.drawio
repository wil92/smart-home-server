        </mxCell>
        <mxCell id="ws-3" value="Persist/update device; mark WebSocket id connected" style="edgeStyle=none;html=1;endArrow=block;rounded=0;strokeColor=#4d6c9c;fontSize=11;labelBackgroundColor=#f6fbf5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="680" y="285" as="sourcePoint"/><mxPoint x="220" y="285" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ws-note" value="The connection is now eligible for Google QUERY and EXECUTE requests. On server startup, stored device on-state is reset to false." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="495" y="305" width="370" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="sync-heading" value="2. Google SYNC — discover configured devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="370" width="1290" height="32" as="geometry"/>
