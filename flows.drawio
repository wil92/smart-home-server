        <mxCell id="title" value="Communication flows exercised by the tests&#xa;Messages are shown in request/response order; grouped outcomes are separate tested branches." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="860" height="55" as="geometry"/>
