        <mxCell id="sync-2" value="Read stored devices; build id/type/name/traits/state-reporting metadata" style="edgeStyle=none;html=1;endArrow=block;rounded=0;strokeColor=#568a52;fontSize=11;labelBackgroundColor=#f6fbf5;" edge="1" parent="1">
