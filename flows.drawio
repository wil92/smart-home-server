        <mxCell id="ws-heading" value="1. Device connects and registers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="1290" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ws-1" value="Open WebSocket connection" style="edgeStyle=none;html=1;endArrow=block;rounded=0;strokeColor=#4d6c9c;fontSize=11;labelBackgroundColor=#f5f9ff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="220" y="205" as="sourcePoint"/><mxPoint x="680" y="205" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ws-2" value="Send JSON registration: QUERY + device id, type, name, initial state" style="edgeStyle=none;html=1;endArrow=block;rounded=0;strokeColor=#4d6c9c;fontSize=11;labelBackgroundColor=#f5f9ff;" edge="1" parent="1">
