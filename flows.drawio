        <mxCell id="sync-1" value="POST fulfillment: action.devices.SYNC (Bearer access token)" style="edgeStyle=none;html=1;endArrow=block;rounded=0;strokeColor=#568a52;fontSize=11;labelBackgroundColor=#fffaf5;" edge="1" parent="1">
